---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Wrapper from "./Wrapper.astro";
import { t } from "../../i18n";
import { getSite } from "../../lib/content";

interface Props {
  locale?: string;
}

const { locale = "es" } = Astro.props;
const m = t(locale);
const portfolio = (await getSite(locale))!;
---

<div id="bio" class="w-full">
  <Wrapper>
    <div class="flex flex-col md:flex-row justify-between gap-4">
      <div class="flex flex-col gap-4 xl:w-2/3 pr-4">
        <div class="flex flex-col">
          <div
            class="flex items-center gap-2 px-3 py-1 w-fit rounded-full bg-primary-muted text-primary text-sm font-medium mb-4"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-primary"
              ></span>
            </span>
            {m["bio.available"]}
          </div>
          <h1 class="font-serif font-semibold text-4xl text-secondary">
            {
              locale === "es"
                ? `¡Encantado! Soy ${portfolio.name}`
                : `Nice to meet you! I'm ${portfolio.name}`
            }
          </h1>
          <h2 class="font-serif font-semibold text-2xl text-accent">
            Fullstack Developer Junior especializado en Next.js
          </h2>
        </div>
        <div>
          <p class="w-full">{portfolio.bio}</p>
          <div class="flex mt-4 gap-4">
            <a
              href={`${import.meta.env.BASE_URL}cv.pdf`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Button label={m["bio.cv"]}>
                <Icon slot="icon" name="FaFileDownload" size={16} />
              </Button>
            </a>
            <Button variant="secondary" href={portfolio.contacts?.github}>
              <Icon slot="icon" name="FaGithub" size={20} />
            </Button>
            <Button variant="secondary" href={portfolio.contacts?.linkedin}>
              <Icon slot="icon" name="FaLinkedin" size={20} />
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Wrapper>
</div>
