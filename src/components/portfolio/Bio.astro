---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Wrapper from "./Wrapper.astro";
import { t } from "../../i18n";
import { getSite } from "../../lib/content";

interface Props {
  locale?: string;
}

const { locale = "es" } = Astro.props;
const m = t(locale);
const portfolio = (await getSite(locale))!;

const stack = ["React", "Next.js", "Python", "Astro", "Tailwind"];
const servicesHref = "/servicios/";
const services = [
  {
    title: m["services.item.web"],
    desc: m["services.item.web.desc"],
    icon: [
      "M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z",
      "M8 20h8",
      "M12 16v4",
    ],
  },
  {
    title: m["services.item.app"],
    desc: m["services.item.app.desc"],
    icon: ["M9 7l-5 5 5 5", "M15 7l5 5-5 5"],
  },
  {
    title: m["services.item.perf"],
    desc: m["services.item.perf.desc"],
    icon: ["M3.5 17a9 9 0 1 1 17 0", "M12 17l4.5-4.5", "M3 20h18"],
  },
];
const socials = [
  { icon: "FaGithub", href: portfolio.contacts?.github, label: "GitHub" },
  { icon: "FaLinkedin", href: portfolio.contacts?.linkedin, label: "LinkedIn" },
  { icon: "FaTwitter", href: portfolio.contacts?.twitter, label: "Twitter" },
];
---

<div id="bio" class="relative w-full overflow-hidden">
  <div class="bio-glow pointer-events-none absolute inset-0" aria-hidden="true">
  </div>
  <div class="bio-grid pointer-events-none absolute inset-0" aria-hidden="true">
  </div>

  <Wrapper class="relative">
    <div class="flex min-h-[calc(100vh_-_4rem)] items-center py-16">
      <div
        class="grid w-full gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-center"
      >
        <div class="flex flex-col gap-6">
          <span
            class="inline-flex w-fit items-center gap-2 rounded-full bg-primary-muted px-3 py-1 text-sm font-medium text-primary"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"
              ></span>
            </span>
            {m["bio.available"]}
          </span>

          <h1
            class="max-w-4xl font-serif text-5xl font-semibold leading-[1.05] text-secondary sm:text-6xl lg:text-7xl"
          >
            {m["bio.greeting"]} <span class="text-primary">{portfolio.name}</span>
          </h1>

          <p class="font-serif text-2xl text-foreground/80 sm:text-3xl">
            {m["bio.role"]}
          </p>

          <ul class="flex flex-wrap gap-2">
            {
              stack.map((tech) => (
                <li class="rounded-md border border-border px-3 py-1 text-sm text-foreground/70">
                  {tech}
                </li>
              ))
            }
          </ul>

          <p class="max-w-2xl text-base leading-relaxed text-foreground/70 sm:text-lg">
            {m["bio.lead"]}
          </p>

          <div class="mt-2 flex flex-wrap items-center gap-3">
            <Button
              href={`${import.meta.env.BASE_URL}cv.pdf`}
              target="_blank"
              rel="noopener noreferrer"
              label={m["bio.cv"]}
            >
              <Icon slot="icon" name="FaFileDownload" size={16} />
            </Button>
            <div class="flex items-center gap-2">
              {
                socials.map(({ icon, href, label }) => (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={label}
                    class="grid h-10 w-10 place-items-center rounded-md border border-border text-foreground/70 transition-colors hover:border-primary hover:text-primary"
                  >
                    <Icon name={icon} size={18} />
                  </a>
                ))
              }
            </div>
            <a
              href={servicesHref}
              class="group flex w-full items-center gap-3 rounded-xl bg-primary-muted/70 p-3 pr-4 transition-colors hover:bg-primary-muted lg:hidden"
            >
              <span
                class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-background text-primary"
              >
                <svg
                  class="h-5 w-5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 3l9 5-9 5-9-5 9-5z" />
                  <path d="M3 13l9 5 9-5" />
                </svg>
              </span>
              <span class="flex-1">
                <span class="block text-sm font-semibold text-secondary">
                  {m["services.title"]}
                </span>
                <span class="mt-0.5 block text-xs leading-snug text-foreground/60">
                  {m["services.hero"]}
                </span>
              </span>
              <svg
                class="h-4 w-4 shrink-0 text-primary transition-transform duration-300 group-hover:translate-x-1"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>

        <aside class="hidden flex-col lg:flex">
          <p
            class="text-xs font-semibold uppercase tracking-[0.2em] text-primary"
          >
            {m["services.title"]}
          </p>
          <h2
            class="mt-3 font-serif text-3xl font-semibold leading-[1.1] text-secondary"
          >
            {m["services.hero"]}
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-foreground/60">
            {m["services.hero.sub"]}
          </p>

          <ul class="mt-8 flex flex-col gap-6">
            {
              services.map(({ title, desc, icon }) => (
                <li class="group flex items-start gap-4">
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-primary-muted text-primary transition-all duration-300 group-hover:bg-primary group-hover:text-white">
                    <svg
                      class="h-5 w-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {icon.map((d) => <path d={d} />)}
                    </svg>
                  </span>
                  <div class="transition-transform duration-300 group-hover:-translate-y-0.5">
                    <h3 class="text-sm font-semibold text-secondary">
                      {title}
                    </h3>
                    <p class="mt-1 text-sm leading-relaxed text-foreground/60">
                      {desc}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>

          <Button
            href={servicesHref}
            label={m["services.cta"]}
            class="mt-8 w-fit"
          >
            <span slot="icon">
              <svg
                class="h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </Button>
        </aside>
      </div>
    </div>
  </Wrapper>

  <a
    href="#experience"
    aria-label={m["bio.scroll"]}
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-foreground/40 transition-colors hover:text-primary sm:block"
  >
    <svg
      class="h-6 w-6 motion-safe:animate-bounce"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 5v14M19 12l-7 7-7-7"></path>
    </svg>
  </a>
</div>

<style>
  .bio-glow {
    background: radial-gradient(
      50% 50% at 15% 10%,
      color-mix(in srgb, var(--primary) 16%, transparent) 0%,
      transparent 70%
    );
  }
  .bio-grid {
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--foreground) 18%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--foreground) 18%, transparent) 1px,
        transparent 1px
      );
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 60% at 50% 30%, #000 0%, transparent 90%);
    -webkit-mask-image: radial-gradient(
      70% 60% at 50% 30%,
      #000 0%,
      transparent 90%
    );
    opacity: 0.6;
  }
</style>
