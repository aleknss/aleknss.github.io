---
import Wrapper from "./Wrapper.astro";
import Icon from "./Icon.astro";
import { t } from "../../i18n";
import { getProjects } from "../../lib/content";

import tonelaImg from "../../assets/proyectos/tonela.webp";
import tfgImg from "../../assets/proyectos/tfg.webp";
import animepolImg from "../../assets/proyectos/animepol.webp";
import lamparaSlide01 from "../../assets/proyectos/lampara/slide-01.webp";

interface Props {
  slug: string;
  locale?: string;
}

const { slug, locale = "es" } = Astro.props;
const m = t(locale);
const projects = await getProjects(locale);
const project = projects.find((p) => p.logo === slug);

const projectConfigs: Record<string, any> = {
  tonela: {
    image: tonelaImg.src,
    gradientFrom: "from-[#2d2621]",
    gradientTo: "to-[#57514d]",
    borderColor: "border-[#6D4C41]",
    buttonColor: "bg-[#6D4C41]",
  },
  ordenna: {
    image: tfgImg.src,
    gradientFrom: "from-[#1a2238]",
    gradientTo: "to-[#2d3a58]",
    borderColor: "border-[#3e5c8a]",
    buttonColor: "bg-[#3e5c8a]",
  },
  animepol: {
    image: animepolImg.src,
    gradientFrom: "from-[#020617]",
    gradientTo: "to-[#0f172a]",
    borderColor: "border-[#1e293b]",
    buttonColor: "bg-[#1e293b]",
  },
  lampara: {
    image: lamparaSlide01.src,
    gradientFrom: "from-[#0c1f12]",
    gradientTo: "to-[#14532d]",
    borderColor: "border-[#166534]",
    buttonColor: "bg-[#15803d]",
  },
};
---

{
  !project ? (
    <div class="w-full min-h-screen flex items-center justify-center">
      <div class="text-center">
        <h1 class="text-2xl font-serif mb-4">{m["project.notFound"]}</h1>
        <a href="/" class="text-primary hover:underline">
          {m["project.backHome"]}
        </a>
      </div>
    </div>
  ) : (
    <div class="w-full min-h-screen">
      <div
        class={`bg-gradient-to-br ${projectConfigs[project.logo]?.gradientFrom ?? projectConfigs.tonela.gradientFrom} ${projectConfigs[project.logo]?.gradientTo ?? projectConfigs.tonela.gradientTo} py-16`}
      >
        <Wrapper>
          <a
            href="/#projects"
            class="inline-flex items-center gap-2 text-white/80 hover:text-white mb-8 transition-colors"
          >
            <Icon name="FaArrowLeft" size={16} />
            {m["project.back"]}
          </a>
          <div class="flex flex-col lg:flex-row gap-8 items-center">
            <img
              src={projectConfigs[project.logo]?.image ?? projectConfigs.tonela.image}
              alt={project.name}
              class="w-full lg:w-1/2 rounded-lg object-cover aspect-video shadow-2xl"
            />
            <div class="flex flex-col gap-4">
              <h1 class="text-3xl lg:text-4xl font-serif font-bold text-white">
                {project.name}
              </h1>
              <p class="text-white/90 text-lg leading-relaxed">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2 mt-2">
                {(project.skills || []).map((skill) => (
                  <span
                    class={`${projectConfigs[project.logo]?.buttonColor ?? projectConfigs.tonela.buttonColor} text-white text-sm px-4 py-1.5 rounded-full`}
                  >
                    {skill}
                  </span>
                ))}
              </div>
              {project.link ? (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`inline-flex items-center gap-2 ${projectConfigs[project.logo]?.buttonColor ?? projectConfigs.tonela.buttonColor} hover:opacity-90 text-white px-6 py-3 rounded-lg w-fit mt-4 transition-opacity`}
                >
                  <Icon name="FaExternalLinkAlt" size={16} />
                  {m["project.visit"]}
                </a>
              ) : null}
            </div>
          </div>
        </Wrapper>
      </div>
    </div>
  )
}
