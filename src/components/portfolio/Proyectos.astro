---
import Wrapper from "./Wrapper.astro";
import Title from "./Title.astro";
import ProjectCard from "./ProjectCard.astro";
import Icon from "./Icon.astro";
import { t } from "../../i18n";
import { getProjects } from "../../lib/content";

import tonelaImg from "../../assets/proyectos/tonela.webp";
import tfgImg from "../../assets/proyectos/tfg.webp";
import animepolImg from "../../assets/proyectos/animepol.webp";

interface Props {
  locale?: string;
}

const { locale = "es" } = Astro.props;
const m = t(locale);

const lamparaSlides = (
  Object.values(
    import.meta.glob("../../assets/proyectos/lampara/*.webp", {
      eager: true,
      import: "default",
    }),
  ) as any[]
)
  .map((mod) => mod.src ?? mod)
  .sort();

const projectConfigs: Record<string, { image: string; slides?: string[] }> = {
  tonela: { image: tonelaImg.src },
  ordenna: { image: tfgImg.src },
  animepol: { image: animepolImg.src },
  lampara: { image: lamparaSlides[0], slides: lamparaSlides },
};

const projects = await getProjects(locale);
---

<div id="projects" class="w-full">
  <Wrapper>
    <div class="flex flex-col gap-4">
      <Title>
        <Icon name="AiOutlineFundProjectionScreen" size={24} />
        {m["nav.projects"]}
      </Title>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          projects.map((project) => {
            const config = projectConfigs[project.logo] || projectConfigs.tonela;
            return (
              <ProjectCard
                data={project}
                image={config.image}
                slides={config.slides}
                linkLabel={m["project.visit"]}
                locale={locale}
              />
            );
          })
        }
      </div>
    </div>
  </Wrapper>
</div>
