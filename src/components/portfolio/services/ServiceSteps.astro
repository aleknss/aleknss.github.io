---
import type { ServiceStep } from "../../../lib/types";

interface Props {
  steps: ServiceStep[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((step, index) => (
      <li class="relative rounded-xl border border-border p-6">
        <span
          class="font-serif text-3xl font-semibold text-primary/30"
          aria-hidden="true"
        >
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3 class="mt-3 text-base font-semibold text-secondary">
          {step.title}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-foreground/65">
          {step.description}
        </p>
      </li>
    ))
  }
</ol>
