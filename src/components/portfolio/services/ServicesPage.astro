---
import Base from "../../../layouts/Base.astro";
import Shell from "../Shell.astro";
import Wrapper from "../Wrapper.astro";
import Button from "../Button.astro";
import Proyectos from "../Proyectos.astro";
import Contacto from "../Contacto.astro";
import ServicesHeader from "./ServicesHeader.astro";
import ServiceTierCard from "./ServiceTierCard.astro";
import ServiceSteps from "./ServiceSteps.astro";
import ServiceFaq from "./ServiceFaq.astro";
import ServiceTestimonials from "./ServiceTestimonials.astro";
import { t } from "../../../i18n";
import type { MessageKey } from "../../../i18n";
import { getServices, getSite } from "../../../lib/content";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale ?? "es" } = Astro.props;
const m = t(locale);
const home = locale === "en" ? "/en/" : "/";
const path = `${home}servicios/`;
const services = await getServices(locale);
const service = services[0]!;
const testimonials = services.flatMap((item) => item.testimonials);
const portfolio = await getSite(locale);
const email = portfolio?.contacts?.email ?? "";
const mailto = `mailto:${email}?subject=${encodeURIComponent(service.title)}`;

const navItems: { id: string; key: MessageKey }[] = [
  { id: "empresa", key: "nav.company" },
  { id: "precios", key: "nav.pricing" },
  { id: "proceso", key: "nav.process" },
  { id: "projects", key: "nav.projects" },
  { id: "faq", key: "nav.faq" },
  { id: "contact", key: "nav.contact" },
];

const site = Astro.site ?? new URL("https://alek.is-a.dev");
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  description: service.description,
  provider: {
    "@type": "ProfessionalService",
    name: "Alek Suso",
    areaServed: "ES",
    email,
    url: site.href,
  },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "EUR",
    lowPrice: service.priceFrom ?? undefined,
    highPrice: service.priceTo ?? undefined,
    offerCount: service.tiers.length,
  },
};
---

<Base
  path={path}
  locale={locale}
  title={`${service.title} — ${m["services.company"]}`}
  description={service.description}
>
  <Shell
    locale={locale}
    slideTransition
    navItems={navItems}
    servicesLink={false}
  >
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <ServicesHeader service={service} locale={locale} />

    <Wrapper class="pb-24">
      {
        service.differentials.length > 0 && (
          <section class="pt-4">
            <h2 class="text-center font-serif text-2xl font-semibold text-secondary">
              {m["services.differentials"]}
            </h2>
            <ul class="mx-auto mt-8 grid max-w-4xl gap-4 sm:grid-cols-2">
              {service.differentials.map((item) => (
                <li class="flex items-start gap-3 rounded-xl bg-primary-muted/50 p-4 text-sm text-foreground/75">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 12l5 5L20 6" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        services.map((item, index) => (
          <section
            id={index === 0 ? "precios" : `precios-${index + 1}`}
            class={index === 0 ? "pt-20" : "pt-16"}
          >
            <h2 class="text-center font-serif text-2xl font-semibold text-secondary">
              {index === 0 ? m["services.pricing"] : item.title}
            </h2>
            {item.tiers.length > 0 && (
              <div class="mt-8 grid gap-6 lg:grid-cols-3">
                {item.tiers.map((tier) => (
                  <ServiceTierCard tier={tier} locale={locale} />
                ))}
              </div>
            )}
          </section>
        ))
      }

      {
        service.steps.length > 0 && (
          <section id="proceso" class="pt-20">
            <h2 class="text-center font-serif text-2xl font-semibold text-secondary">
              {m["services.process"]}
            </h2>
            <div class="mt-8">
              <ServiceSteps steps={service.steps} />
            </div>
          </section>
        )
      }

      {testimonials.length > 0 && (
        <ServiceTestimonials testimonials={testimonials} locale={locale} />
      )}

      {
        service.faq.length > 0 && (
          <section id="faq" class="pt-20">
            <h2 class="text-center font-serif text-2xl font-semibold text-secondary">
              {m["services.faq"]}
            </h2>
            <div class="mx-auto mt-8">
              <ServiceFaq faq={service.faq} />
            </div>
          </section>
        )
      }

      <section class="mt-20 border-t border-border pt-12 text-center">
        <h2 class="font-serif text-3xl font-semibold text-secondary sm:text-4xl">
          {m["services.start"]}
        </h2>
        <p class="mx-auto mt-3 max-w-md text-sm text-foreground/65">
          {m["services.hero.sub"]}
        </p>
        {
          service.hourlyRate && (
            <p class="mt-2 text-xs text-foreground/50">
              {m["services.hourly"]}: {service.hourlyRate} €/h,{" "}
              {m["services.hourlyNote"]}.
            </p>
          )
        }
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <Button href={mailto} label={m["services.startEmail"]} />
          <Button
            variant="secondary"
            href={`${home}#contact`}
            label={m["services.startForm"]}
          />
        </div>
      </section>

      {
        service.featuredClient && (
          <p class="mt-10 text-center text-sm">
            <a
              href={service.featuredClient.href}
              class="text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
            >
              {m["services.featuredClient"]}: {service.featuredClient.name}
            </a>
          </p>
        )
      }
    </Wrapper>

    <Proyectos locale={locale} />
    <Contacto locale={locale} />
  </Shell>
</Base>
