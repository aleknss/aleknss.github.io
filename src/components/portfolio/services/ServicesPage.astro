---
import Base from "../../../layouts/Base.astro";
import Shell from "../Shell.astro";
import Wrapper from "../Wrapper.astro";
import Button from "../Button.astro";
import Contacto from "../Contacto.astro";
import NarrativeHero from "./NarrativeHero.astro";
import StorySection from "./StorySection.astro";
import ServiceTierCard from "./ServiceTierCard.astro";
import ServiceSteps from "./ServiceSteps.astro";
import ServiceFaq from "./ServiceFaq.astro";
import ServiceTestimonials from "./ServiceTestimonials.astro";
import ServiceClients from "./ServiceClients.astro";
import { t } from "../../../i18n";
import type { MessageKey } from "../../../i18n";
import { getClients, getServices, getSite } from "../../../lib/content";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale ?? "es" } = Astro.props;
const m = t(locale);
const home = locale === "en" ? "/en/" : "/";
const path = `${home}servicios/`;
const services = await getServices(locale);
const service = services[0]!;
const clients = await getClients(locale);
const testimonials = services.flatMap((item) => item.testimonials);
const portfolio = await getSite(locale);
const email = portfolio?.contacts?.email ?? "";
const mailto = `mailto:${email}?subject=${encodeURIComponent(service.title)}`;

const navItems: { id: string; key: MessageKey }[] = [
  { id: "empresa", key: "nav.company" },
  { id: "precios", key: "nav.pricing" },
  { id: "proceso", key: "nav.process" },
  { id: "clients", key: "nav.clients" },
  { id: "faq", key: "nav.faq" },
  { id: "contact", key: "nav.contact" },
];

const compareRows = [
  {
    label: "services.compare.row1",
    without: "services.compare.row1.without",
    with: "services.compare.row1.with",
    icon: "M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z",
  },
  {
    label: "services.compare.row2",
    without: "services.compare.row2.without",
    with: "services.compare.row2.with",
    icon: "M12 3l7 3v6c0 3.9-2.9 7-7 9-4.1-2-7-5.1-7-9V6l7-3Z",
  },
  {
    label: "services.compare.row3",
    without: "services.compare.row3.without",
    with: "services.compare.row3.with",
    icon: "M21 12a8 8 0 0 1-8 8H8l-4 3v-6.5A8 8 0 1 1 21 12Z",
  },
  {
    label: "services.compare.row4",
    without: "services.compare.row4.without",
    with: "services.compare.row4.with",
    icon: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
] satisfies {
  label: MessageKey;
  without: MessageKey;
  with: MessageKey;
  icon: string;
}[];

const site = Astro.site ?? new URL("https://alek.is-a.dev");
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  description: service.description,
  provider: {
    "@type": "ProfessionalService",
    name: "Alek Suso",
    areaServed: "ES",
    email,
    url: site.href,
  },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "EUR",
    lowPrice: service.priceFrom ?? undefined,
    highPrice: service.priceTo ?? undefined,
    offerCount: service.tiers.length,
  },
};
---

<Base
  path={path}
  locale={locale}
  title={`${service.title} — ${m["services.company"]}`}
  description={service.description}
>
  <Shell
    locale={locale}
    slideTransition
    navItems={navItems}
    servicesLink={false}
  >
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    />

    <div
      class="reading-progress fixed inset-x-0 top-16 z-40 h-0.5 origin-left bg-primary"
      aria-hidden="true"
    >
    </div>

    <NarrativeHero service={service} locale={locale} />

    {
      service.problem && (
        <StorySection
          index="01"
          label={m["services.chapter.problem"]}
          id="problema"
        >
          <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
            {service.problem.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-foreground/70">
            {service.problem.text}
          </p>
          <div class="mt-10" data-reveal>
            <table
              class="w-full table-fixed border-separate border-spacing-0 overflow-hidden rounded-xl border border-border text-left"
            >
              <caption class="sr-only">{m["services.compare.caption"]}</caption>
              <thead>
                <tr>
                  <td class="w-10 border-b border-border p-3"></td>
                  <th
                    scope="col"
                    class="border-b border-border p-3 text-xs font-semibold uppercase tracking-[0.12em] text-foreground/40"
                  >
                    <span class="flex items-center gap-2">
                      <svg
                        class="h-4 w-4 shrink-0"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        aria-hidden="true"
                      >
                        <path d="M15 9l-6 6M9 9l6 6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                      </svg>
                      <span class="hidden sm:inline">{m["services.compare.without"]}</span>
                      <span
                        class="rounded-full border border-border px-1.5 py-0.5 text-[0.6rem] font-normal tracking-normal"
                      >
                        {m["services.compare.score.without"]}
                      </span>
                    </span>
                  </th>
                  <th
                    scope="col"
                    class="border-b border-l border-border bg-primary-muted/60 p-3 text-xs font-semibold uppercase tracking-[0.12em] text-primary"
                  >
                    <span class="flex items-center gap-2">
                      <svg
                        class="h-4 w-4 shrink-0"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        aria-hidden="true"
                      >
                        <path d="M3 5h18v14H3V5Zm0 4h18" />
                      </svg>
                      <span class="hidden sm:inline">{m["services.compare.with"]}</span>
                      <span
                        class="rounded-full border border-primary/30 px-1.5 py-0.5 text-[0.6rem] font-normal tracking-normal"
                      >
                        {m["services.compare.score.with"]}
                      </span>
                    </span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  compareRows.map((row) => (
                    <tr class="group">
                      <th scope="row" class="border-b border-border p-3 align-top">
                        <svg
                          class="h-4 w-4 text-foreground/40"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d={row.icon} />
                        </svg>
                        <span class="sr-only">{m[row.label]}</span>
                      </th>
                      <td class="border-b border-border p-3 align-top text-sm leading-snug text-foreground/50 transition-colors group-hover:text-foreground/70">
                        <span class="flex gap-2">
                          <svg
                            class="mt-0.5 h-4 w-4 shrink-0 text-foreground/30"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            aria-hidden="true"
                          >
                            <path d="M18 6 6 18M6 6l12 12" />
                          </svg>
                          <span>{m[row.without]}</span>
                        </span>
                      </td>
                      <td class="relative border-b border-l border-border bg-primary-muted/60 p-3 align-top text-sm leading-snug text-foreground/80 transition-colors group-hover:bg-primary-muted">
                        <span
                          class="absolute -left-2.5 top-1/2 hidden -translate-y-1/2 text-primary/50 opacity-0 transition-opacity group-hover:opacity-100 sm:block"
                          aria-hidden="true"
                        >
                          →
                        </span>
                        <span class="flex gap-2">
                          <svg
                            class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M4 12l5 5L20 6" />
                          </svg>
                          <span>{m[row.with]}</span>
                        </span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
              <tfoot>
                <tr>
                  <td class="p-3"></td>
                  <td class="p-3 text-xs font-semibold uppercase tracking-[0.1em] text-foreground/40">
                    {m["services.compare.result.without"]}
                  </td>
                  <td class="border-l border-border bg-primary-muted/60 p-3 text-xs font-semibold uppercase tracking-[0.1em] text-primary">
                    {m["services.compare.result.with"]}
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </StorySection>
      )
    }

    <StorySection index="02" label={m["nav.pricing"]} id="precios">
      <h2 class="max-w-2xl font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
        {m["services.pricing.sub"]}
      </h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          service.tiers.map((tier) => (
            <ServiceTierCard tier={tier} locale={locale} />
          ))
        }
      </div>
      {
        service.hourlyRate && (
          <p class="mt-6 text-xs text-foreground/50">
            {m["services.hourly"]}: {service.hourlyRate} €/h,{" "}
            {m["services.hourlyNote"]}.
          </p>
        )
      }
    </StorySection>

    {
      service.steps.length > 0 && (
        <StorySection
          index="03"
          label={m["nav.process"]}
          id="proceso"
        >
          <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
            {m["services.process"]}
          </h2>
          <div class="mt-8">
            <ServiceSteps steps={service.steps} />
          </div>
        </StorySection>
      )
    }

    <StorySection
      index="04"
      label={m["services.chapter.proof"]}
      id="clients"
    >
      <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
        {m["services.chapter.proof"]}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-foreground/70">
        {m["services.proof.text"]}
      </p>
      {
        clients.length > 0 && (
          <div class="mt-10">
            <ServiceClients clients={clients} locale={locale} />
          </div>
        )
      }
      {
        testimonials.length > 0 && (
          <div class="mt-10">
            <ServiceTestimonials testimonials={testimonials} locale={locale} />
          </div>
        )
      }
    </StorySection>

    <StorySection
      index="05"
      label={m["services.chapter.about"]}
      id="empresa"
    >
      <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
        {m["services.chapter.about"]}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-foreground/70">
        {portfolio?.bio}
      </p>
      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
        {m["services.chapter.guarantees"]}
      </p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          service.differentials.map((item) => (
            <li class="flex items-start gap-3 border-b border-border pb-3 text-sm text-foreground/75">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 12l5 5L20 6" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </StorySection>

    {
      service.faq.length > 0 && (
        <StorySection index="06" label={m["nav.faq"]} id="faq">
          <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
            {m["services.faq"]}
          </h2>
          <div class="mt-8">
            <ServiceFaq faq={service.faq} />
          </div>
        </StorySection>
      )
    }

    {
      service.featuredClient && (
        <Wrapper class="pb-16">
          <a
            href={service.featuredClient.href}
            class="text-sm text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
          >
            {m["services.featuredClient"]}: {service.featuredClient.name}
          </a>
        </Wrapper>
      )
    }

    <section data-reveal class="w-full border-t border-border">
      <Wrapper class="py-20 text-center lg:py-28">
        <h2 class="font-serif text-4xl font-semibold text-secondary sm:text-5xl">
          {m["services.start"]}
        </h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-foreground/65">
          {m["services.hero.sub"]}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <Button href={`#contact`} label={m["services.startForm"]} />
          <Button
            variant="secondary"
            href={mailto}
            label={m["services.startEmail"]}
          />
        </div>
      </Wrapper>
    </section>

    <Contacto locale={locale} />
  </Shell>
</Base>

<style is:global>
  html.reveal-on [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  html.reveal-on [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html.reveal-on [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initNarrative() {
    const items = document.querySelectorAll("[data-reveal]");
    const progress = document.querySelector<HTMLElement>(".reading-progress");

    if ("IntersectionObserver" in window) {
      document.documentElement.classList.add("reveal-on");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.05, rootMargin: "0px 0px -5% 0px" },
      );
      items.forEach((item) => observer.observe(item));
    }

    if (progress) {
      const update = () => {
        const max = document.body.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    }
  }

  document.addEventListener("astro:page-load", initNarrative);
  initNarrative();
</script>
