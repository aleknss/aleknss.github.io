---
import Base from "../../../layouts/Base.astro";
import Shell from "../Shell.astro";
import Wrapper from "../Wrapper.astro";
import Button from "../Button.astro";
import Contacto from "../Contacto.astro";
import NarrativeHero from "./NarrativeHero.astro";
import StorySection from "./StorySection.astro";
import ServiceTierCard from "./ServiceTierCard.astro";
import ServiceSteps from "./ServiceSteps.astro";
import ServiceFaq from "./ServiceFaq.astro";
import ServiceTestimonials from "./ServiceTestimonials.astro";
import ServiceClients from "./ServiceClients.astro";
import { t } from "../../../i18n";
import type { MessageKey } from "../../../i18n";
import { getClients, getServices, getSite } from "../../../lib/content";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale ?? "es" } = Astro.props;
const m = t(locale);
const home = locale === "en" ? "/en/" : "/";
const path = `${home}servicios/`;
const services = await getServices(locale);
const service = services[0]!;
const clients = await getClients(locale);
const testimonials = services.flatMap((item) => item.testimonials);
const portfolio = await getSite(locale);
const email = portfolio?.contacts?.email ?? "";
const mailto = `mailto:${email}?subject=${encodeURIComponent(service.title)}`;

const navItems: { id: string; key: MessageKey }[] = [
  { id: "empresa", key: "nav.company" },
  { id: "precios", key: "nav.pricing" },
  { id: "proceso", key: "nav.process" },
  { id: "clients", key: "nav.clients" },
  { id: "faq", key: "nav.faq" },
  { id: "contact", key: "nav.contact" },
];

const site = Astro.site ?? new URL("https://alek.is-a.dev");
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  serviceType: service.title,
  description: service.description,
  provider: {
    "@type": "ProfessionalService",
    name: "Alek Suso",
    areaServed: "ES",
    email,
    url: site.href,
  },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "EUR",
    lowPrice: service.priceFrom ?? undefined,
    highPrice: service.priceTo ?? undefined,
    offerCount: service.tiers.length,
  },
};
---

<Base
  path={path}
  locale={locale}
  title={`${service.title} — ${m["services.company"]}`}
  description={service.description}
>
  <Shell
    locale={locale}
    slideTransition
    navItems={navItems}
    servicesLink={false}
  >
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    />

    <div
      class="reading-progress fixed inset-x-0 top-16 z-40 h-0.5 origin-left bg-primary"
      aria-hidden="true"
    >
    </div>

    <NarrativeHero service={service} locale={locale} />

    {
      service.problem && (
        <StorySection
          index="01"
          label={m["services.chapter.problem"]}
          id="problema"
        >
          <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
            {service.problem.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-foreground/70">
            {service.problem.text}
          </p>
          <ul class="mt-8 flex flex-col gap-3">
            {service.problem.points.map((point) => (
              <li class="flex items-start gap-3 border-b border-border pb-3 text-sm text-foreground/70">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-foreground/30" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </StorySection>
      )
    }

    {
      service.solution && (
        <StorySection
          index="02"
          label={m["services.chapter.solution"]}
          id="solucion"
        >
          <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
            {service.solution.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-foreground/70">
            {service.solution.text}
          </p>
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {service.solution.points.map((point) => (
              <li class="flex items-start gap-3 rounded-lg bg-primary-muted/60 p-3 text-sm text-foreground/75">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 12l5 5L20 6" />
                </svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </StorySection>
      )
    }

    <StorySection index="03" label={m["nav.pricing"]} id="precios" wide>
      <h2 class="max-w-2xl font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
        {m["services.pricing.sub"]}
      </h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          service.tiers.map((tier) => (
            <ServiceTierCard tier={tier} locale={locale} />
          ))
        }
      </div>
      {
        service.hourlyRate && (
          <p class="mt-6 text-xs text-foreground/50">
            {m["services.hourly"]}: {service.hourlyRate} €/h,{" "}
            {m["services.hourlyNote"]}.
          </p>
        )
      }
    </StorySection>

    {
      service.steps.length > 0 && (
        <StorySection
          index="04"
          label={m["nav.process"]}
          id="proceso"
        >
          <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
            {m["services.process"]}
          </h2>
          <div class="mt-8">
            <ServiceSteps steps={service.steps} />
          </div>
        </StorySection>
      )
    }

    <StorySection
      index="05"
      label={m["services.chapter.proof"]}
      id="clients"
      wide
    >
      <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
        {m["services.chapter.proof"]}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-foreground/70">
        {m["services.proof.text"]}
      </p>
      {
        clients.length > 0 && (
          <div class="mt-10">
            <ServiceClients clients={clients} locale={locale} />
          </div>
        )
      }
      {
        testimonials.length > 0 && (
          <div class="mt-10">
            <ServiceTestimonials testimonials={testimonials} locale={locale} />
          </div>
        )
      }
    </StorySection>

    <StorySection
      index="06"
      label={m["services.chapter.about"]}
      id="empresa"
    >
      <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
        {m["services.chapter.about"]}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-foreground/70">
        {portfolio?.bio}
      </p>
      <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
        {m["services.chapter.guarantees"]}
      </p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          service.differentials.map((item) => (
            <li class="flex items-start gap-3 border-b border-border pb-3 text-sm text-foreground/75">
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 12l5 5L20 6" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </StorySection>

    {
      service.faq.length > 0 && (
        <StorySection index="07" label={m["nav.faq"]} id="faq">
          <h2 class="font-serif text-3xl font-semibold leading-tight text-secondary sm:text-4xl">
            {m["services.faq"]}
          </h2>
          <div class="mt-8">
            <ServiceFaq faq={service.faq} />
          </div>
        </StorySection>
      )
    }

    {
      service.featuredClient && (
        <Wrapper class="pb-16">
          <a
            href={service.featuredClient.href}
            class="text-sm text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
          >
            {m["services.featuredClient"]}: {service.featuredClient.name}
          </a>
        </Wrapper>
      )
    }

    <section data-reveal class="w-full border-t border-border">
      <Wrapper class="py-20 text-center lg:py-28">
        <h2 class="font-serif text-4xl font-semibold text-secondary sm:text-5xl">
          {m["services.start"]}
        </h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-foreground/65">
          {m["services.hero.sub"]}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <Button href={`#contact`} label={m["services.startForm"]} />
          <Button
            variant="secondary"
            href={mailto}
            label={m["services.startEmail"]}
          />
        </div>
      </Wrapper>
    </section>

    <Contacto locale={locale} />
  </Shell>
</Base>

<style is:global>
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initNarrative() {
    const items = document.querySelectorAll("[data-reveal]");
    const progress = document.querySelector<HTMLElement>(".reading-progress");

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -10% 0px" },
      );
      items.forEach((item) => observer.observe(item));
    } else {
      items.forEach((item) => item.classList.add("is-visible"));
    }

    if (progress) {
      const update = () => {
        const max = document.body.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    }
  }

  document.addEventListener("astro:page-load", initNarrative);
</script>
