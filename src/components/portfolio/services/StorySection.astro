---
import Wrapper from "../Wrapper.astro";

interface Props {
  id?: string;
  index?: string;
  label?: string;
  wide?: boolean;
}

const { id, index, label, wide = false } = Astro.props;
---

<section
  id={id}
  data-reveal
  class="relative w-full border-t border-border"
>
  <Wrapper class="py-20 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[9rem_minmax(0,1fr)]">
      <div class="lg:sticky lg:top-24 lg:self-start">
        {index && (
          <p
            class="font-serif text-6xl font-semibold leading-none tabular-nums text-primary/60"
            aria-hidden="true"
          >
            {index}
          </p>
        )}
        {label && (
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
            {label}
          </p>
        )}
      </div>
      <div class={wide ? "min-w-0" : "max-w-3xl"}>
        <slot />
      </div>
    </div>
  </Wrapper>
</section>
