---
import { t } from "../../../i18n";
import type { ServiceTestimonial } from "../../../lib/types";

interface Props {
  testimonials: ServiceTestimonial[];
  locale?: string;
}

const { testimonials, locale = "es" } = Astro.props;
const m = t(locale);
---

<section id="testimonios" class="pt-20">
  <h3 class="text-center font-serif text-xl font-semibold text-secondary">
    {m["services.testimonials"]}
  </h3>
  <ul class="mx-auto mt-8 grid max-w-4xl gap-6 sm:grid-cols-2">
    {
      testimonials.map((item) => (
        <li class="rounded-xl border border-border p-6">
          <blockquote class="font-serif text-lg leading-relaxed text-foreground/80">
            “{item.quote}”
          </blockquote>
          <p class="mt-4 text-sm font-semibold text-secondary">
            {item.author}
          </p>
          {item.role && (
            <p class="text-xs text-foreground/55">{item.role}</p>
          )}
        </li>
      ))
    }
  </ul>
</section>
