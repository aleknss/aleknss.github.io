---
import Icon from "./Icon.astro";
import SlideViewer from "./SlideViewer.astro";
import { t } from "../../i18n";

interface Props {
  data: {
    name: string;
    description: string;
    link?: string | null;
    skills: string[];
  };
  image: string;
  slides?: string[];
  linkLabel?: string;
  locale?: string;
}

const {
  data,
  image,
  slides,
  linkLabel = "Ver proyecto",
  locale = "es",
} = Astro.props;
const m = t(locale);
---

<div data-project>
  <div
    class="group flex flex-col overflow-hidden rounded-xl border border-border bg-background transition-all duration-300 hover:-translate-y-1 hover:border-primary hover:shadow-xl hover:shadow-primary/10"
  >
    <div class="relative overflow-hidden">
      {
        slides ? (
          <SlideViewer images={slides} name={data.name} />
        ) : (
          <button
            type="button"
            data-modal-open
            aria-label={data.name}
            class="block w-full cursor-pointer"
          >
            <img
              src={image}
              alt={data.name}
              loading="lazy"
              class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </button>
        )
      }
    </div>

    <div class="flex flex-1 flex-col gap-3 p-5">
      <h3 class="font-serif text-xl font-semibold text-secondary">
        <button
          type="button"
          data-modal-open
          class="cursor-pointer text-left transition-colors group-hover:text-primary"
        >
          {data.name}
        </button>
      </h3>
      <ul class="mt-auto flex flex-wrap gap-2 pt-2">
        {
          data.skills.map((skill) => (
            <li class="rounded-md border border-border px-2.5 py-1 text-xs text-foreground/60">
              {skill}
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        data-modal-open
        class="mt-1 inline-flex w-fit cursor-pointer items-center gap-1.5 text-sm font-medium text-primary"
      >
        {linkLabel}
        <Icon
          name="FaChevronRight"
          size={12}
          class="transition-transform duration-300 group-hover:translate-x-0.5"
        />
      </button>
    </div>
  </div>

  <dialog
    data-project-modal
    class="m-auto max-h-[90vh] w-[min(92vw,44rem)] overflow-hidden rounded-2xl border border-border bg-background p-0 text-foreground shadow-2xl shadow-black/40 backdrop:bg-black/60 backdrop:backdrop-blur-sm open:flex open:flex-col"
  >
    <div class="relative shrink-0">
      {
        slides ? (
          <SlideViewer images={slides} name={data.name} />
        ) : (
          <img
            src={image}
            alt={data.name}
            class="aspect-video w-full object-cover"
          />
        )
      }
      <form method="dialog" class="absolute right-3 top-3 z-30">
        <button
          type="submit"
          aria-label={m["project.close"]}
          class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-black/60 text-white transition-colors hover:bg-black/80"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            class="h-5 w-5"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </form>
    </div>

    <div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto p-6">
      <h3 class="font-serif text-2xl font-semibold text-secondary">
        {data.name}
      </h3>
      <ul class="flex flex-wrap gap-2">
        {
          data.skills.map((skill) => (
            <li class="rounded-md border border-border px-2.5 py-1 text-xs text-foreground/60">
              {skill}
            </li>
          ))
        }
      </ul>
      <p class="leading-relaxed text-foreground/75">{data.description}</p>
      {
        data.link ? (
          <a
            href={data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-fit items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all duration-300 hover:-translate-y-0.5 hover:bg-accent"
          >
            <Icon name="FaExternalLinkAlt" size={14} />
            {m["project.visit"]}
          </a>
        ) : null
      }
    </div>
  </dialog>
</div>

<script>
  function initProjectModals() {
    document.querySelectorAll("[data-project]").forEach((root) => {
      if ((root as HTMLElement).dataset.modalBound) return;
      (root as HTMLElement).dataset.modalBound = "true";

      const dialog = root.querySelector(
        "dialog[data-project-modal]",
      ) as HTMLDialogElement | null;
      if (!dialog) return;

      root.querySelectorAll("[data-modal-open]").forEach((trigger) => {
        trigger.addEventListener("click", () => dialog.showModal());
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  document.addEventListener("astro:page-load", initProjectModals);
  initProjectModals();
</script>
