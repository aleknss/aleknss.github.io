---
import TopNav from "./TopNav.astro";

interface Props {
  locale?: string;
  slideTransition?: boolean;
}

const { locale = "es", slideTransition = false } = Astro.props;
---

<TopNav locale={locale} />
<main
  id="main-content"
  class="pt-16"
  transition:name="content"
  transition:animate={slideTransition ? "slide" : "none"}
>
  <slot />
</main>
