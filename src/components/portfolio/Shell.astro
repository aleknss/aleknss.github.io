---
import TopNav from "./TopNav.astro";
import type { MessageKey } from "../../i18n";

interface Props {
  locale?: string;
  slideTransition?: boolean;
  hideHeader?: boolean;
  navItems?: { id: string; key: MessageKey }[];
  servicesLink?: boolean;
}

const {
  locale = "es",
  slideTransition = false,
  hideHeader = false,
  navItems,
  servicesLink = false,
} = Astro.props;
---

{!hideHeader && <TopNav locale={locale} items={navItems} servicesLink={servicesLink} />}
<main
  id="main-content"
  class={hideHeader ? "" : "pt-16"}
  transition:name="content"
  transition:animate={slideTransition ? "slide" : "none"}
>
  <slot />
</main>
