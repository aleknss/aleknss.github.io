---
interface Props {
  variant?: "primary" | "secondary";
  href?: string;
  label?: string;
  header?: boolean;
  class?: string;
}

const {
  variant = "primary",
  href,
  label = "",
  header = false,
  class: className = "",
} = Astro.props;

const isPrimary = variant === "primary";
const base =
  "flex justify-center items-center gap-2 text-sm cursor-pointer transition-colors duration-300 ease-in-out";
const styles = isPrimary
  ? "px-3 py-2 text-white dark:text-background bg-primary hover:bg-accent rounded"
  : "px-1 sm:px-3 py-2 text-primary hover:text-accent";

const Tag = href ? "a" : "button";
---

<Tag href={href} class={`${base} ${styles} ${className}`}>
  <slot name="icon" />
  {label && <span class={header ? "hidden lg:block" : ""}>{label}</span>}
</Tag>
