---
import Wrapper from "./Wrapper.astro";
import ContactForm from "./ContactForm.astro";
import Icon from "./Icon.astro";
import TNF from "../../assets/TNF.svg";
import { t } from "../../i18n";
import { getSite } from "../../lib/content";

interface Props {
  locale?: string;
}

const { locale = "es" } = Astro.props;
const m = t(locale);
const contacts = (await getSite(locale))!.contacts;
---

<footer id="contact" class="w-full">
  <div class="w-full h-full bg-lime-900">
    <Wrapper>
      <div class="flex flex-col gap-6">
        <p
          class="flex gap-2 items-center font-serif font-bold text-2xl text-accent"
        >
          <Icon name="FaPaperPlane" size={24} />
          {m["nav.contact"]}
        </p>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <ContactForm locale={locale} />
          <div class="grid grid-cols-1 gap-4 content-start">
            <a
              href={`mailto:${contacts.email}`}
              class="flex items-center gap-4 text-white hover:text-accent"
            >
              <Icon name="FaEnvelope" size={20} class="text-accent" />
              {contacts.email}
            </a>
            <a
              href={`tel:${contacts.phone}`}
              class="flex items-center gap-4 text-white hover:text-accent"
            >
              <Icon name="FaPhone" size={20} class="text-accent" />
              {contacts.phone}
            </a>
            <a
              class="flex items-center gap-4 text-white hover:text-accent"
              href={contacts.twitter}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="FaTwitter" size={20} class="text-accent" />
              {contacts.twitter}
            </a>
            <a
              href={contacts.linkedin}
              class="flex items-center gap-4 text-white hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="FaLinkedin" size={20} class="text-accent" />
              {contacts.linkedin}
            </a>
            <a
              href={contacts.github}
              class="flex items-center gap-4 text-white hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="FaGithub" size={20} class="text-accent" />
              {contacts.github}
            </a>
            <div class="flex items-center gap-4 text-white">
              <Icon name="HiLocationMarker" size={20} class="text-accent" />
              {contacts.location}
              <img
                src={TNF.src}
                alt="Bandera de Tenerife."
                loading="lazy"
                class="h-5"
              />
            </div>
          </div>
        </div>
      </div>
    </Wrapper>
  </div>
</footer>
